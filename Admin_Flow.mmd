sequenceDiagram
    autonumber
    actor Admin
    participant Ctrl as AdminController
    participant Svc as AdminService
    participant AccRepo as AccountRepository
    participant FailRepo as FailedLoginRepository
    participant DB as Database

    Admin->>Ctrl: POST /Admin/{Action} (Suspend/Unlock)
    activate Ctrl

    alt Action is Suspend / Unsuspend
        Ctrl->>Svc: SuspendAccountAsync(id)
        activate Svc
        Svc->>AccRepo: UpdateAccountStatus(id, isSuspended)
        activate AccRepo
        AccRepo->>DB: UPDATE Accounts SET IsSuspended = value
        activate DB
        DB-->>AccRepo: Success
        deactivate DB
        AccRepo-->>Svc: Success
        deactivate AccRepo
        Svc-->>Ctrl: Success
        deactivate Svc

    else Action is Unlock
        Ctrl->>Svc: UnlockAccountAsync(id)
        activate Svc
        
        Svc->>AccRepo: ClearLockoutEndDate(id)
        activate AccRepo
        AccRepo->>DB: UPDATE Accounts SET LockoutEnd = null
        activate DB
        DB-->>AccRepo: Success
        deactivate DB
        AccRepo-->>Svc: Success
        deactivate AccRepo
        
        Svc->>FailRepo: ResetFailedLoginAttempts(id)
        activate FailRepo
        FailRepo->>DB: UPDATE Accounts SET AccessFailedCount = 0
        activate DB
        DB-->>FailRepo: Success
        deactivate DB
        FailRepo-->>Svc: Success
        deactivate FailRepo
        
        Svc-->>Ctrl: Success
        deactivate Svc
    end

    Ctrl-->>Admin: Redirect to Index (Success Message)
    deactivate Ctrl