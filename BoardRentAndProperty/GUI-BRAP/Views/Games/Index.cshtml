@model IEnumerable<GameDTO>

@{
    ViewData["Title"] = "Games";
}

<h1>Games</h1>

@if (TempData["DeleteError"] is string deleteError)
{
    <div class="alert alert-danger" role="alert">@deleteError</div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

@if (Model is null || !Model.Any())
{
    <p>No games available.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Owner</th>
                <th>Price</th>
                <th>Players</th>
                <th>Description</th>
                <th>Active</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@(item.Owner?.DisplayName ?? "-")</td>
                <td>@item.Price</td>
                <td>@item.MinimumPlayerNumber - @item.MaximumPlayerNumber</td>
                <td>@item.Description</td>
                <td>@(item.IsActive ? "Yes" : "No")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
