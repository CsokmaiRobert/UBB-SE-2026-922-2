@model IReadOnlyList<BoardRentAndProperty.Contracts.DataTransferObjects.NotificationDTO>

@{
    ViewData["Title"] = "My Notifications";

    int totalCount = (int)(ViewData["TotalCount"] ?? 0);
    int currentPage = (int)(ViewData["CurrentPage"] ?? 1);
    int pageSize = (int)(ViewData["PageSize"] ?? 3);

    int totalPages = (int)Math.Ceiling((double)totalCount / pageSize);
    if (totalPages == 0) totalPages = 1;

    int startItem = totalCount == 0 ? 0 : ((currentPage - 1) * pageSize) + 1;
    int endItem = Math.Min(startItem + Model.Count - 1, totalCount);
}

<style>
    .notifications-container {
        --notif-circle-size: 50px;
        --notif-icon-color: #6c757d;
        --notif-border-color: #dee2e6;
        --notif-bg-light: #f8f9fa;
        --notif-card-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    }

    .notification-circle {
        width: var(--notif-circle-size);
        height: var(--notif-circle-size);
        background-color: var(--notif-bg-light);
        border: 1px solid var(--notif-border-color);
    }

    .notification-icon {
        color: var(--notif-icon-color);
    }
</style>

<div class="notifications-container">
    <h2 class="fw-bold mb-4">@ViewData["Title"]</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info border-0 shadow-sm">
            You do not have any notifications yet.
        </div>
    }
    else
    {
        <div class="notification-list d-flex flex-column gap-3">
            @foreach (var notification in Model)
            {
                <div class="card border-0 shadow-sm" style="box-shadow: var(--notif-card-shadow) !important;">
                    <div class="card-body d-flex align-items-center">

                        <div class="flex-shrink-0 me-3">
                            <div class="notification-circle rounded-circle d-flex align-items-center justify-content-center shadow-sm">
                                <i class="bi bi-bell-fill fs-5 notification-icon"></i>
                            </div>
                        </div>

                        <div class="notification-body flex-grow-1">
                            <h5 class="fw-bold mb-1">@notification.Title</h5>
                            <p class="text-muted mb-1">@notification.Body</p>
                            <small class="text-secondary d-block">@notification.TimeDisplay</small>
                        </div>

                        <div class="ms-3">
                            <form asp-action="Delete" asp-route-id="@notification.Id" method="post" onsubmit="return confirm('Delete this notification?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                                    Delete
                                </button>
                            </form>
                        </div>

                    </div>
                </div>
            }
        </div>

        <div class="mt-5 d-flex justify-content-between align-items-center border-top pt-3">
            <div class="text-muted small">
                Showing <strong>@startItem-@endItem</strong> of <strong>@totalCount</strong>
            </div>

            <div class="pagination-controls d-flex align-items-center gap-2">
                <a asp-action="Index" asp-route-page="@(currentPage - 1)"
                   class="btn btn-dark btn-sm px-3 @(currentPage <= 1 ? "disabled" : "")">
                    Previous
                </a>

                <span class="mx-2 small fw-bold">@currentPage / @totalPages</span>

                <a asp-action="Index" asp-route-page="@(currentPage + 1)"
                   class="btn btn-dark btn-sm px-3 @(currentPage >= totalPages ? "disabled" : "")">
                    Next
                </a>
            </div>
        </div>
    }
</div>