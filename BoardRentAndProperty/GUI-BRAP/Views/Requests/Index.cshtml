@model IEnumerable<BoardRentAndProperty.Api.Models.Request>

@{
    ViewData["Title"] = "Requests";
}

<div class="page-header">
    <h1 class="page-title">Requests</h1>
    <div class="page-actions">
        <a class="btn btn-primary" asp-action="Create">Create New</a>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.StartDate)</th>
                <th>@Html.DisplayNameFor(model => model.EndDate)</th>
                <th>@Html.DisplayNameFor(model => model.Status)</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
@foreach (var item in Model) {
            var statusClass = item.Status.ToString() switch
            {
                "Open" => "bg-warning text-dark",
                "OfferPending" => "bg-info text-dark",
                "Accepted" => "bg-success",
                "Cancelled" => "bg-secondary",
                _ => "bg-secondary"
            };
            <tr>
                <td>@Html.DisplayFor(modelItem => item.StartDate)</td>
                <td>@Html.DisplayFor(modelItem => item.EndDate)</td>
                <td><span class="badge @statusClass status-badge">@item.Status</span></td>
                <td>
                    <div class="table-actions">
                        <a class="btn btn-warning btn-sm" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                        <a class="btn btn-info btn-sm" asp-action="Details" asp-route-id="@item.Id">Details</a>
                        <a class="btn btn-danger btn-sm" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    </div>
                </td>
            </tr>
}
        </tbody>
    </table>
</div>
