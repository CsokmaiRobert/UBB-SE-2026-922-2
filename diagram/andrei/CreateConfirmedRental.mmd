sequenceDiagram
    autonumber
    actor User
    participant RC as RentalsController
    participant RS as RentalService
    participant RR as RentalRepository
    participant DB as Database

    User->>RC: POST /Rentals/Create (CreateRentalDataTransferObject)
    activate RC

    RC->>RS: CreateConfirmedRental(gameId, renterId, ownerId, startDate, endDate)
    activate RS

    RS->>RS: HasValidFutureDateRange(startDate, endDate)
    RS->>RS: IsSlotAvailable(gameId, startDate, endDate)

    RS->>RR: AddConfirmed(rental)
    activate RR
    RR->>DB: SaveChanges()
    activate DB
    DB-->>RR: Success
    deactivate DB
    RR-->>RS: Rental Created
    deactivate RR

    RS-->>RC: Success
    deactivate RS

    RC-->>User: RedirectToAction(My)
    deactivate RC
