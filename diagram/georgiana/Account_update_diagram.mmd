---
config:
  theme: mc
---
sequenceDiagram
    autonumber
    actor User
    participant WebUI as "WebUI (Browser)"
    participant ProfileController as "ProfileController.cs"
    participant AccountProxyService as "AccountProxyService.cs"
    participant IAccountService as "BoardRentAndProperty.ApiClient: IAccountService"
    participant AccountService as "API: AccountService"
    participant AccountRepository as "API: AccountRepository"
    participant SQL as "SQL Database"

    User->>WebUI: Click "Save Changes" / "Update Password"
    activate WebUI
    
    WebUI->>ProfileController: HTTP POST /Profile/Index or /Profile/ChangePassword
    activate ProfileController
    
    ProfileController->>AccountProxyService: UpdateProfileAsync(currentUserId, updateData) / ChangePasswordAsync(currentUserId, currentPassword, newPassword)
    activate AccountProxyService
    
    Note over AccountProxyService: Maps data to unified contract<br/>AccountProfileDataTransferObject
    
    AccountProxyService->>IAccountService: UpdateProfileAsync(accountId, profileUpdateData) / ChangePasswordAsync(accountId, currentPassword, newPassword)
    activate IAccountService
    
    IAccountService->>AccountService: HTTP PUT /api/accounts/{id} (or /change-password)
    activate AccountService
    
    Note over AccountService: ValidateProfileDetails(profileUpdateData)<br/>VerifyPassword(currentPassword, accountEntity.PasswordHash)
    
    AccountService->>AccountRepository: UpdateAsync(accountEntity)
    activate AccountRepository
    
    AccountRepository->>SQL: dbContext.Accounts.FindAsync(id) -> dbContext.SaveChangesAsync()
    activate SQL
    SQL-->>AccountRepository: Committed changes to database
    deactivate SQL
    
    AccountRepository-->>AccountService: Task Completed
    deactivate AccountRepository
    
    AccountService-->>IAccountService: ServiceResult<bool>.Ok(true)
    deactivate AccountService
    
    IAccountService-->>AccountProxyService: Task<ServiceResult>
    deactivate IAccountService
    
    Note over AccountProxyService: If (!result.Success)<br/>throw ProxyServiceException()
    
    AccountProxyService-->>ProfileController: Task Completed
    deactivate AccountProxyService
    
    Note over ProfileController: TempData["SuccessMessage"] = <br/>"Profile updated successfully."
    
    ProfileController-->>WebUI: RedirectToAction(nameof(this.Index)) / RedirectToAction("Login", "Auth")
    deactivate ProfileController
    
    WebUI-->>User: UI updates with success message
    deactivate WebUI
