sequenceDiagram
    actor User
    participant View as ListingsPage.xaml.cs
    participant VM as ListingsViewModel.cs
    participant ApiClient as ApiClient/GameService.cs
    participant Controller as GamesController.cs
    participant Service as Api/GameService.cs
    participant RentalRepo as RentalRepository.cs
    participant RequestSvc as RequestService.cs
    participant RequestRepo as RequestRepository.cs
    participant NotifSvc as NotificationService.cs
    participant Mapper as GameMapper.cs
    participant GameRepo as GameRepository.cs
    participant DB as SQL Database

    User->>View: click Delete button (Button.Click)
    View->>View: DeleteGameButton_Click(sender, routedEventArgs)
    Note over View: DialogHelper.ShowConfirmationAsync(DeleteGameConfirmation)
    User-->>View: ContentDialogResult.Primary (confirm)

    View->>VM: TryDeleteGameAsync(gameToDelete)
    VM->>VM: DeleteGameAsync(gameToDelete)
    Note over VM: CanManageGame(gameToManage) authorization check
    VM->>ApiClient: DeleteGameAsync(gameToDelete.Id)
    ApiClient->>Controller: HTTP DELETE /api/games/{gameId}
    Controller->>Service: DeleteGameByIdentifier(gameId)

    Note over Service: Check active rentals
    Service->>RentalRepo: GetRentalsByGame(gameId)
    RentalRepo->>DB: SELECT * FROM Rentals WHERE GameId = gameId
    DB-->>RentalRepo: rentals
    RentalRepo-->>Service: ImmutableList<Rental>
    Note over Service: activeCount = rentals.Count(r => r.EndDate >= now)

    alt activeCount > 0 (active rentals exist)
        Service-->>Controller: throw InvalidOperationException
        Controller-->>ApiClient: 409 Conflict (game_delete_conflict)
        ApiClient-->>VM: ServiceResult.Fail(error)
        VM-->>View: ViewOperationResult.Failure(CannotDeleteGame)
        View-->>User: DialogHelper.ShowMessageAsync (cannot delete)
    else activeCount == 0

        loop foreach rental in gameRentals
            Service->>RentalRepo: Delete(rental.Id)
            RentalRepo->>DB: DELETE FROM Rentals WHERE Id = rental.Id (SaveChanges)
            DB-->>RentalRepo: deleted Rental
            RentalRepo-->>Service: Rental
        end

        Note over Service: Cancel pending requests
        Service->>RequestSvc: OnGameDeactivated(gameId)
        RequestSvc->>RequestRepo: GetRequestsByGame(deactivatedGameId)
        RequestRepo->>DB: SELECT * FROM Requests WHERE GameId = gameId
        DB-->>RequestRepo: requests
        RequestRepo-->>RequestSvc: ImmutableList<Request>
        Note over RequestSvc: pending = requests where Status == Open or OfferPending

        loop foreach pendingRequest in pending
            RequestSvc->>NotifSvc: DeleteNotificationsLinkedToRequest(pendingRequest.Id)
            NotifSvc->>DB: DELETE FROM Notifications WHERE RelatedRequestId = pendingRequest.Id
            DB-->>NotifSvc: ok
            RequestSvc->>RequestRepo: Delete(pendingRequest.Id)
            RequestRepo->>DB: DELETE FROM Requests WHERE Id = pendingRequest.Id (SaveChanges)
            DB-->>RequestRepo: deleted Request
            RequestSvc->>NotifSvc: SendNotificationToUser(renterId, NotificationDTO)
            NotifSvc->>DB: INSERT INTO Notifications (SaveChanges)
            DB-->>NotifSvc: ok
        end
        RequestSvc-->>Service: void

        Note over Service: Delete the game listing
        Service->>GameRepo: Delete(gameId)
        GameRepo->>DB: DELETE FROM Games WHERE Id = gameId (SaveChanges)
        DB-->>GameRepo: deleted Game
        GameRepo-->>Service: Game

        Service->>Mapper: ToDTO(game)
        Mapper-->>Service: GameDTO
        Service-->>Controller: GameDTO
        Controller-->>ApiClient: 200 OK (GameDTO)
        ApiClient-->>VM: ServiceResult.Ok(GameDTO)
        VM->>VM: ReloadAsync()
        VM-->>View: ViewOperationResult.Success(GameRemoved)
        View-->>User: DialogHelper.ShowMessageAsync (removed successfully)
    end
